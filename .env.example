# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in YOUR values.
# .env is git-ignored — NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── FastAPI / Uvicorn ─────────────────────────────────────────────────────────
PORT=8000
API_HOST=0.0.0.0

# CORS: comma-separated allowed origins.
# Use * for local dev only. In production, set explicit domains:
#   CORS_ORIGINS=https://my-domain.com,https://api.my-domain.com
CORS_ORIGINS=*

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=M2_Pune_Real_Estate_Price

# ── DagsHub (optional — remote DVC + MLflow) ─────────────────────────────────
# Sign up at https://dagshub.com, create a repo, copy your token from
# User Settings → Tokens.
DAGSHUB_USER=YOUR_DAGSHUB_USERNAME
DAGSHUB_TOKEN=YOUR_DAGSHUB_TOKEN
DAGSHUB_REPO=YOUR_DAGSHUB_REPO_NAME

# ── AWS (required for ECR push + ECS / App Runner deploy) ────────────────────
AWS_ACCOUNT_ID=YOUR_12_DIGIT_AWS_ACCOUNT_ID
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

ECR_REPO_NAME=pune-price-prediction
ECR_IMAGE_TAG=latest

# ── AWS ECS Fargate ───────────────────────────────────────────────────────────
ECS_CLUSTER_NAME=pune-price-cluster
ECS_SERVICE_NAME=pune-price-service
ECS_TASK_FAMILY=pune-price-prediction

# ── AWS App Runner ────────────────────────────────────────────────────────────
APP_RUNNER_SERVICE_NAME=pune-price-prediction

# ── AWS Secrets Manager ───────────────────────────────────────────────────────
SECRET_NAME=pune-price-prediction/env
